0/1030206"],"hasURL":["https://hdl.handle.net/hdl:20.500.11840/1030206"],"inScheme":"http://data.europeana.eu/scheme/pid/handle"}],"providedCHOs":[{"about":"/item/2048221/europeana_fashion_1030206"}],"proxies":[{"about":"/proxy/europeana/2048221/europeana_fashion_1030206","dcDate":{"def":["#1975%2F1985"]},"dcFormat":{"def":["http://data.europeana.eu/concept/2820"]},"dcIdentifier":{"def":["http://mint-projects.image.ntua.gr/europeana-fashion/1030206"]},"dcType":{"def":["http://data.europeana.eu/concept/2569"]},"dctermsCreated":{"def":["#1975","#1975%2F1985"]},"dctermsMedium":{"def":["http://data.europeana.eu/concept/2022"]},"proxyIn":["/aggregation/europeana/2048221/europeana_fashion_1030206"],"proxyFor":"/item/2048221/europeana_fashion_1030206","lineage":["/proxy/provider/2048221/europeana_fashion_1030206","/proxy/aggregator/2048221/europeana_fashion_1030206"],"edmType":"IMAGE","year":{"def":["1975"]},"europeanaProxy":true,"pidList":{"def":["#pid_0"]}},{"about":"/proxy/aggregator/2048221/europeana_fashion_1030206","dcDescription":{"en":["The sarong consists of two hand-sewn ikat cloths of hand-spun cotton, with additional woven white lines or symmetrical figures. The badan is blue, the kepala is red. The sarong is worn during the first and second (sometimes third) evening and night of the harvest ritual in each main village in Sahu. A second, matching sarong should be hung over the left shoulder (sangkola) with a point downwards."]},"dcTitle":{"en":["Blue-red ikat sarong"]},"edmIsRelatedTo":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10414","http://thesaurus.europeanafashion.eu/thesaurus/10402","http://thesaurus.europeanafashion.eu/thesaurus/10422","http://thesaurus.europeanafashion.eu/thesaurus/11079"]},"proxyIn":["/aggregation/aggregator/2048221/europeana_fashion_1030206"],"proxyFor":"/item/2048221/europeana_fashion_1030206","lineage":["/proxy/provider/2048221/europeana_fashion_1030206"],"edmType":"IMAGE","europeanaProxy":false},{"about":"/proxy/provider/2048221/europeana_fashion_1030206","dcDate":{"nl":["1975-1985"]},"dcDescription":{"nl":["De sarong bestaat uit twee boven elkaar (hand)genaaide ikat doeken van handgesponnen katoen, met supplementair geweven witte lijnen of symmetrische figuren. De badan is blauw, de kepala is rood. De sarong wordt gedragen tijdens de eerste en tweede (soms derde) avond en nacht van het oogstritueel in ieder hoofddorp in Sahu. Een tweede, bijbehorende sarong hoort over de linker schouder te worden gehangen (sangkola) met een punt naar beneden."]},"dcFormat":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10370"],"en":["Technique: weaving techniques"]},"dcIdentifier":{"def":["7038-2"]},"dcTitle":{"nl":["Blauw-rode ikat sarong"]},"dcType":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10033","'Ba’a boba"],"en":["Object Type: sarong"],"nl":["sarong"]},"dctermsCreated":{"nl":["1975-1985","1975"]},"dctermsIsPartOf":{"en":["Europeana XX: Century of Change"]},"dctermsMedium":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10354"],"en":["Material: cotton"]},"dctermsProvenance":{"nl":["2015-04-15","Aankoop"]},"proxyIn":["/aggregation/provider/2048221/europeana_fashion_1030206"],"proxyFor":"/item/2048221/europeana_fashion_1030206","edmType":"IMAGE","europeanaProxy":false}],"timespans":[{"about":"#1975%2F1985","prefLabel":{"zxx":["1975/1985"]},"begin":{"def":["1975-01-01"]},"end":{"def":["1985-12-31"]},"isPartOf":{"def":["http://data.europeana.eu/timespan/20"]},"skosNotation":{"def":["1975/1985"]}},{"about":"#1975","prefLabel":{"zxx":["1975"]},"begin":{"def":["1975-01-01"]},"end":{"def":["1975-12-31"]},"isPartOf":{"def":["http://data.europeana.eu/timespan/20"]},"skosNotation":{"def":["1975"]}},{"about":"http://data.europeana.eu/timespan/20","prefLabel":{"de":["20. Jahrhundert"],"ru":["XX век"],"fi":["1900-luku"],"pt":["Século XX"],"bg":["20 век"],"lt":["XX amžius"],"lv":["20. gadsimts"],"hr":["20. stoljeće"],"fr":["XXe siècle"],"hu":["20. század"],"sk":["20. storoči