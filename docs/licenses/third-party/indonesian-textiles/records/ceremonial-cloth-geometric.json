xy.ashx%3Fserver%3Dlocalhost%26port%3D17581%26filename%3Dimages%2F%2FImages%2FTM%2FTM-1772-1508.jpg&type=IMAGE","edmLandingPage":"https://www.europeana.eu/item/2048221/europeana_fashion_66157","dqvHasQualityAnnotation":[{"created":"2025-11-12T16:11:32.382073771Z","target":["/aggregation/europeana/2048221/europeana_fashion_66157"],"body":"http://www.europeana.eu/schemas/epf/contentTier4"},{"created":"2025-11-12T16:11:32.382078469Z","target":["/aggregation/europeana/2048221/europeana_fashion_66157"],"body":"http://www.europeana.eu/schemas/epf/metadataTierB"}]},"europeanaCollectionName":["2048221_EuropeanaFashion_1040"],"europeanaCompleteness":0,"organizations":[{"about":"http://data.europeana.eu/organization/2187","prefLabel":{"en":["National Museum of World Cultures Foundation"],"nl":["Nationaal Museum van Wereldculturen"]}},{"about":"http://data.europeana.eu/organization/4499","prefLabel":{"en":["European Fashion Heritage Association"]}}],"persistentIdentifiers":[{"about":"#pid_0","value":"hdl:20.500.11840/66157","notation":["https://hdl.handle.net/20.500.11840/66157"],"hasURL":["https://hdl.handle.net/hdl:20.500.11840/66157"],"inScheme":"http://data.europeana.eu/scheme/pid/handle"}],"providedCHOs":[{"about":"/item/2048221/europeana_fashion_66157"}],"proxies":[{"about":"/proxy/europeana/2048221/europeana_fashion_66157","dcIdentifier":{"def":["http://mint-projects.image.ntua.gr/europeana-fashion/66157"]},"dcType":{"def":["http://data.europeana.eu/concept/55"]},"dctermsCreated":{"def":["#1940"]},"dctermsMedium":{"def":["http://data.europeana.eu/concept/2130","http://data.europeana.eu/concept/1980"]},"proxyIn":["/aggregation/europeana/2048221/europeana_fashion_66157"],"proxyFor":"/item/2048221/europeana_fashion_66157","lineage":["/proxy/provider/2048221/europeana_fashion_66157","/proxy/aggregator/2048221/europeana_fashion_66157"],"edmType":"IMAGE","europeanaProxy":true,"pidList":{"def":["#pid_0"]}},{"about":"/proxy/aggregator/2048221/europeana_fashion_66157","dcDescription":{"en":["Cloth with variously coloured geometric figures, including four large stars (Gittinger, M. 1979:148, no. 110), oblique diamonds, stylised animals such as scorpions and lobsters. The ends have a border (30cm.) with motifs in gold and silver thread. Weaving with gold and silver thread is called songket (Pelras, C., 1962:229).\\Ikat is a technique in which the threads of a fabric are first tied off, according to pattern, after which they are dipped into a dye bath. The tied off parts are not dyed. This process can be repeated a number of times, so that a multicoloured pattern is created.\\ Depending on whether the dyeing process has been applied to the warp, weft or both threads, this technique is called warp-ikat, weft-ikat and double-ikat. The first is the most common.Before the threads are tied off, they are often folded over each other, both lengthwise and widthwise. With such a method, the motifs appear in mirror image."]},"dcTitle":{"en":["Silk ceremonial cloth with geometric and animal figures in weftikat and with gold and silver thread"]},"edmIsRelatedTo":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10768","http://thesaurus.europeanafashion.eu/thesaurus/10422","http://thesaurus.europeanafashion.eu/thesaurus/10371","http://thesaurus.europeanafashion.eu/thesaurus/10407","http://thesaurus.europeanafashion.eu/thesaurus/11079","http://thesaurus.europeanafashion.eu/thesaurus/10470","http://thesaurus.europeanafashion.eu/thesaurus/10546"]},"proxyIn":["/aggregation/aggregator/2048221/europeana_fashion_66157"],"proxyFor":"/item/2048221/europeana_fashion_66157","lineage":["/proxy/provider/2048221/europeana_fashion_66157"],"edmType":"IMAGE","europeanaProxy":false},{"about":"/proxy/provider/2048221/europeana_fashion_66157","dcDate":{"nl":["voor 1940"]},"dcDescription":{"nl":["Doek met verschillend gekleurde geometrische figuren, o.a. vier grote sterren (Gittinger, M. 1979:148, nr. 110), schuine ruiten, gestyleerde dieren als schorpioenen en kreeften. De uiteinden hebben een rand (30cm.) met motieven in goud- en zilverdraad. Weefwerk met goud- en zilverdraad wordt songket genoemd (Pelras, C., 1962:229).\n\nVervaardiging\nIkat is een techniek waarbij de draden van een weefsel eerst, volgens patroon, afgebonden worden, waarna ze in een verfbad worden gedompeld. De afgebonden delen worden niet geverfd. Dit proces kan een aantal keer herhaald worden, zodat een meerkleurig patroon ontstaat.\nAl naar gelang het verfproces is toegepast op de schering-, inslag- of beide draden wordt deze techniek scheringikat, inslag-ikat en dubbel-ikat genoemd. De eerste komt het meest voor.\n\nVoor de draden afgebonden worden, worden ze vaak over elkaar gevouwen, zowel in de lengte als in de breedte- richting. Bij zo'n werkwijze verschijnen de motieven in spiegelbeeld."]},"dcIdentifier":{"nl":["Doek"]},"dcTitle":{"nl":["Zijden ceremoniële doek met geometrische en dierfiguren in inslagikat en met goud- en zilverdraad"]},"dcType":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10509"],"en":["Object Type: fabric"],"nl":["Doek"]},"dctermsCreated":{"nl":["0-1940"]},"dctermsIsPartOf":{"en":["Europeana XX: Century of Change"]},"dctermsMedium":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/11055","http://thesaurus.europeanafashion.eu/thesaurus/10352"],"en":["Material: alloy","Material: silk"]},"dctermsProvenance":{"nl":["1994-01-01","Schenking"]},"proxyIn":["/aggregation/provider/2048221/europeana_fashion_66157"],"proxyFor":"/item/2048221/europeana_fashion_66157","edmType":"IMAGE","europeanaProxy":false}],"timespans":[{"about":"#1940","prefLabel":{"zxx":["1940"]},"begin":{"def":["1940-01-01"]},"end":{"def":["1940-12-31"]},"isPartOf":{"def":["http://data.europeana.eu/timespan/20"]},"skosNotation":{"def":["1940"]}},{"about":"http://data.europeana.eu/timespan/20","prefLabel":{"de":["20. Jahrhundert"],"ru":["XX век"],"fi":["1900-luku"],"pt":["Século XX"],"bg":["20 век"],"lt":["XX amžius"],"lv":["20. gadsimts"],"hr":["20. stoljeć