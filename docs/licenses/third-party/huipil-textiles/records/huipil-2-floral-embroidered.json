anization/4499","prefLabel":{"en":["European Fashion Heritage Association"]}}],"persistentIdentifiers":[{"about":"#pid_0","value":"hdl:20.500.11840/804358","notation":["https://hdl.handle.net/20.500.11840/804358"],"hasURL":["https://hdl.handle.net/hdl:20.500.11840/804358"],"inScheme":"http://data.europeana.eu/scheme/pid/handle"}],"providedCHOs":[{"about":"/item/2048221/europeana_fashion_804358"}],"proxies":[{"about":"/proxy/europeana/2048221/europeana_fashion_804358","dcDate":{"def":["#1935%7E"]},"dcIdentifier":{"def":["http://mint-projects.image.ntua.gr/europeana-fashion/804358"]},"dctermsCreated":{"def":["#1935","#1935%2F1935"]},"dctermsMedium":{"def":["http://data.europeana.eu/concept/2022"]},"proxyIn":["/aggregation/europeana/2048221/europeana_fashion_804358"],"proxyFor":"/item/2048221/europeana_fashion_804358","lineage":["/proxy/provider/2048221/europeana_fashion_804358","/proxy/aggregator/2048221/europeana_fashion_804358"],"edmType":"IMAGE","year":{"def":["1935"]},"europeanaProxy":true,"pidList":{"def":["#pid_0"]}},{"about":"/proxy/aggregator/2048221/europeana_fashion_804358","dcDescription":{"en":["This \"huipil\" was worn with wraparound skirt 5075-412 and faja 5075-627 worn at fiestas.‖ The traditional fiesta wear in Amatlán de los Reyes consists of a \"huipil\" and a wrap skirt. This \"fiesta huipil\" is made of imported linen and richly embroidered. Around 1900 the huipiles were still woven by hand. Although the \"huipil\" gives the impression of consisting of three parts, it only consists of one part that is folded in half and sewn together at the sides. The embroidered flowers are based on western embroidery patterns. Coral necklaces were often worn with this costume. A lot of money was always spent on this costume."]},"dcTitle":{"en":["Huipil"]},"edmIsRelatedTo":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10584","http://thesaurus.europeanafashion.eu/thesaurus/11079","http://thesaurus.europeanafashion.eu/thesaurus/10355"]},"proxyIn":["/aggregation/aggregator/2048221/europeana_fashion_804358"],"proxyFor":"/item/2048221/europeana_fashion_804358","lineage":["/proxy/provider/2048221/europeana_fashion_804358"],"edmType":"IMAGE","europeanaProxy":false},{"about":"/proxy/provider/2048221/europeana_fashion_804358","dcDate":{"nl":["c. 1935"]},"dcDescription":{"nl":["Deze \"huipil\" werd met wikkelrok 5075-412 en \"faja\" 5075-627 gedragen op feesten.\n\nDe traditionele feestdracht in Amatlán de los Reyes bestaat uit een “huipil” en een wikkelrok. Deze “fiesta huipil” is gemaakt van geïmporteerd linnen en rijk geborduurd. Rond 1900 werden de “huipiles” nog met de hand geweven. Hoewel de “huipil” de impressie geeft te bestaan uit drie delen, bestaat hij slechts uit één deel dat is dubbel gevouwen en aan de zijkanten dichtgenaaid. De geborduurde bloemen zijn gebaseerd op westerse borduurpatronen. Vaak werden ook halskettingen van koraal bij deze dracht gedragen. Er werd altijd veel geld besteed aan deze feestdracht."]},"dcIdentifier":{"def":["RV-5075-410"]},"dcTitle":{"nl":["Huipil"]},"dcType":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10017","huipil"],"en":["Object Type: main garments upper body"],"nl":["huipil"]},"dctermsCreated":{"nl":["1935-1935","1935"]},"dctermsIsPartOf":{"en":["Europeana XX: Century of Change"]},"dctermsMedium":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10354"],"en":["Material: cotton"]},"dctermsProvenance":{"nl":["1980-01-01","Aankoop"]},"proxyIn":["/aggregation/provider/2048221/europeana_fashion_804358"],"proxyFor":"/item/2048221/europeana_fashion_804358","edmType":"IMAGE","europeanaProxy":false}],"timespans":[{"about":"#1935%7E","prefLabel":{"zxx":["1935~"]},"note":{"def":["approximate"]},"begin":{"def":["1935-01-01"]},"end":{"def":["1935-12-31"]},"isPartOf":{"def":["http://data.europeana.eu/timespan/20"]},"skosNotation":{"def":["1935~"]}},{"about":"#1935%2F1935","prefLabel":{"zxx":["1935/1935"]},"begin":{"def":["1935-01-01"]},"end":{"def":["1935-12-31"]},"isPart