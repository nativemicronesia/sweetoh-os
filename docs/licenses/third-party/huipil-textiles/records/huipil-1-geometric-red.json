on_1040"],"europeanaAggregation":{"about":"/aggregation/europeana/2048221/europeana_fashion_851655","aggregatedCHO":"/item/2048221/europeana_fashion_851655","edmCountry":{"def":["Netherlands"]},"edmLanguage":{"def":["mul"]},"edmPreview":"https://api.europeana.eu/thumbnail/v2/url.json?uri=http%3A%2F%2Fcollectie.wereldculturen.nl%2Fcc%2Fimageproxy.ashx%3Fserver%3Dlocalhost%26port%3D17581%26filename%3Dimages%2F%2FImages%2FRV%2FRV-5946-653.jpg&type=IMAGE","edmLandingPage":"https://www.europeana.eu/item/2048221/europeana_fashion_851655","dqvHasQualityAnnotation":[{"created":"2025-11-12T16:17:00.971753714Z","target":["/aggregation/europeana/2048221/europeana_fashion_851655"],"body":"http://www.europeana.eu/schemas/epf/contentTier4"},{"created":"2025-11-12T16:17:00.971758824Z","target":["/aggregation/europeana/2048221/europeana_fashion_851655"],"body":"http://www.europeana.eu/schemas/epf/metadataTierC"}]},"europeanaCollectionName":["2048221_EuropeanaFashion_1040"],"europeanaCompleteness":0,"organizations":[{"about":"http://data.europeana.eu/organization/2187","prefLabel":{"en":["National Museum of World Cultures Foundation"],"nl":["Nationaal Museum van Wereldculturen"]}},{"about":"http://data.europeana.eu/organization/4499","prefLabel":{"en":["European Fashion Heritage Association"]}}],"persistentIdentifiers":[{"about":"#pid_0","value":"hdl:20.500.11840/851655","notation":["https://hdl.handle.net/20.500.11840/851655"],"hasURL":["https://hdl.handle.net/hdl:20.500.11840/851655"],"inScheme":"http://data.europeana.eu/scheme/pid/handle"}],"providedCHOs":[{"about":"/item/2048221/europeana_fashion_851655"}],"proxies":[{"about":"/proxy/europeana/2048221/europeana_fashion_851655","dcDate":{"def":["#1967"]},"dcFormat":{"def":["http://data.europeana.eu/concept/2820"]},"dcIdentifier":{"def":["http://mint-projects.image.ntua.gr/europeana-fashion/851655"]},"dctermsCreated":{"def":["#1967%2F1967"]},"dctermsMedium":{"def":["http://data.europeana.eu/concept/2022"]},"proxyIn":["/aggregation/europeana/2048221/europeana_fashion_851655"],"proxyFor":"/item/2048221/europeana_fashion_851655","lineage":["/proxy/provider/2048221/europeana_fashion_851655","/proxy/aggregator/2048221/europeana_fashion_851655"],"edmType":"IMAGE","year":{"def":["1967"]},"europeanaProxy":true,"pidList":{"def":["#pid_0"]}},{"about":"/proxy/aggregator/2048221/europeana_fashion_851655","dcDescription":{"en":["The huipil is a simple rectangular, sleeveless garment that covers the shoulders and part of the arms and may fall to the hips in length, but reaches to the ankles elsewhere. In Mixtec, the huipil is also called 'Shiku lestu'. Wearing it expresses many aspects of social life. \\The huipil is made of white hand-spun cotton. The huipil consists of three loose strips woven in flat weave. These three strips are stitched together, the stitching of which is covered by a red ribbon. The ribbon is an influence from the European world, before this, the huipils were attached by randa work (decorative stitch). \\The entire huipil is decorated with red stripes, which are spaced about 10cm to 15cm apart. This creates an alternating pattern of red and (through the background) white stripes. In some places, the red stripes are replaced by a row of colorful geometric shapes.Ó The huipil contains a narrow v neck that is finished by red yarn. Huipil to be worn with a wrap skirt and belt.\\In 1999, the huipil was donated to the museum by Irmgard Johnson. \\Part of a woman's costume with wrap skirt and belt (5946 - 654/655)."]},"dcTitle":{"en":["Huipil"]},"edmIsRelatedTo":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10416","http://thesaurus.europeanafashion.eu/thesaurus/10414","http://thesaurus.europeanafashion.eu/thesaurus/10797","http://thesaurus.europeanafashion.eu/thesaurus/11079","http://thesaurus.europeanafashion.eu/thesaurus/10372"]},"proxyIn":["/aggregation/aggregator/2048221/europeana_fashion_851655"],"proxyFor":"/item/2048221/europeana_fashion_851655","lineage":["/proxy/provider/2048221/europeana_fashion_851655"],"edmType":"IMAGE","europeanaProxy":false},{"about":"/proxy/provider/2048221/europeana_fashion_851655","dcDate":{"nl":["1967"]},"dcDescription":{"nl":["De huipil is een eenvoudig rechthoekig, mouwloos kledingstuk dat de schouders en een deel van de armen bedekt en in de lengte tot op de heupen kan vallen, maar elders tot aan de enkels reikt. In het Mixteeks wordt de huipil ook wel ‘Shiku lestu’ genoemd. Met het dragen ervan worden vele aspecten van het sociale leven tot uiting gebracht. \n\nDe huipil is gemaakt van wit handgesponnen katoen. De huipil bestaat uit drie losse stroken die geweven zijn in platbinding. Deze drie stroken zijn aan elkaar gezet, waarvan het stiksel bedekt wordt met een rood lint. Het lint is een invloed uit de Europese wereld, hiervoor werden de huipils vast gemaakt door randa werk (siersteek). \n\nDe hele huipil is versierd met rode strepen, die ca. 10cm tot 15cm van elkaar afstaan. Hierdoor ontstaat er een afwisselende patroon van rood en (door de ondergrond) witte strepen. Op sommige plekken worden de rode strepen vervangen door een rij van kleurrijke geometrische vormen.\n\nDe huipil bevat een smalle v hals die afgewerkt wordt door rood garen. Huipil te dragen met een wikkelrok en een ceintuur.\n\nHuipil geschonken in 1999 door Irmgard Johnson aan het museum. \n\nOnderdeel van een vrouwenkostuum met wikkelrok en ceintuur (5946 - 654/655)."]},"dcFormat":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10370"],"en":["Technique: weaving techniques"]},"dcIdentifier":{"nl":["huipil"]},"dcTitle":{"nl":["Huipil"]},"dcType":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10003"],"en":["Object Type: main garments body"],"nl":["huipil"]},"dctermsCreated":{"nl":["1967-1967"]},"dctermsIsPartOf":{"en":["Europeana XX: Century of Change"]},"dctermsMedium":{"def":["http://thesaurus.europeanafashion.eu/thesaurus/10354"],"en":["Material: cotton"]},"dctermsProvenance":{"nl":["1999-06-01","Aankoop"]},"proxyI