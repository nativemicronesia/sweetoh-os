# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Venture (default: sweetoh)
# SWEETOH_VENTURE_SLUG=sweetoh

# Commerce
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — Sweet'Oh only (Island Sprouts from not required for this app)
RESEND_API_KEY=
SWEETOH_FROM_EMAIL=hello@sweetoh.com
SWEETOH_SUPPORT_EMAIL=support@sweetoh.com

# AI (optional; use AI_MOCK_MODE=true for create without OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_MOCK_MODE=true

# Studio chat (the partner desk's chat bar). Uses OPENAI_API_KEY by default.
# Set AI_BASE_URL to route through an OpenAI-compatible proxy/gateway instead
# (local LiteLLM, or a future shared Dekaz endpoint) — no code change needed.
# AI_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=
# STUDIO_CHAT_API_KEY=
# STUDIO_CHAT_MODEL=gpt-4o-mini

# Seed
FOUNDATION_OWNER_EMAIL=
FOUNDATION_OWNER_PASSWORD=
FOUNDATION_PARTNER_EMAIL=
FOUNDATION_PARTNER_PASSWORD=
# Venture creator (Island Sprouts / NMH) — submits listings for partner approval
# FOUNDATION_CREATOR_EMAIL=
# FOUNDATION_CREATOR_PASSWORD=
# CREATOR_DEFAULT_BRAND_SLUG=island-sprouts

# Dev only — never in production
# ALLOW_MANUAL_ORDER_CHECKOUT=true

# Partner enters via NMH OS when SWEETOH_OS_URL is set there (see nmh-os .env.example).
# This app still has /partner/login for direct access.
#
# Dedicated Supabase project: sweetoh-os (not shared with Island Sprouts / NMH).
# Prefer session pooler for migrations: aws-0-<region>.pooler.supabase.com:5432
# App runtime can use transaction pooler :6543 if preferred.

